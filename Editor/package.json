{
  "name": "ui-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.13.0" },
  "description": "UI 编辑器 — Roblox 工程工作台",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:runtime": "node scripts/build-runtime.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:smoke": "npm run build && node tests/smoke.mjs && node tests/ui-smoke.mjs",
    "test:display": "node tests/roblox-display.mjs",
    "test:roblox-import": "npm run build && node tests/roblox-import-smoke.mjs",
    "test:packaged": "node tests/packaged-smoke.mjs",
    "test:runtime": "npm run build && node tests/runtime-smoke.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "test:mcp": "npm run build && tsx tests/automation-smoke.ts",
    "test:mcp:packaged": "tsx tests/automation-smoke.ts --packaged",
    "test:assets": "npm run build && node tests/image-assets-smoke.mjs",
    "test:templates": "npm run build && node tests/template-assets-smoke.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "lucide-react": "^1.52.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
