  "scripts": {
    "integration": "local FX = _G.FX\nlocal CWindowUIPreviewCompClass = FX.Class(\"CWindowUIPreviewCompClass\", \"CWindowUIBaseCompClass\")\n\n-- 模板无业务接入，动作仅输出模拟记录。\n-- @param action string 操作名\n-- @param payload table 动作参数\nfunction CWindowUIPreviewCompClass:OnUIAction(action, payload)\n    print(\"Template preview: \" .. action)\nend\n\nreturn CWindowUIPreviewCompClass",
    "source": "local FX = _G.FX\nlocal FXLoader = FX.Loader\nlocal CWindowUIBaseCompClass = FX.Class(\"CWindowUIBaseCompClass\", \"FCUICompClass\")\n\n-- 关闭只影响当前模拟窗口，停止或重置恢复设计态。\nfunction CWindowUIBaseCompClass:OnReady()\n    local root = FXLoader:PlayerGui(\"LargeWindowUI\")\n    local titleBox = FXLoader:Here(root, \"TitleBox\")\n    local panel = FXLoader:Here(root, \"PopupPanelImg\")\n    local close = FXLoader:Here(root, \"TitleBox.CloseSurfaceImg\")\n    self:TrackConnection(close.Activated:Connect(function()\n        titleBox.Visible = false\n        panel.Visible = false\n        self:EmitUIAction(\"Close\", {})\n    end))\nend\n\nreturn CWindowUIBaseCompClass"
  },
  "version": 3
}
