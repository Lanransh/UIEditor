  "scripts": {
    "integration": "local FX = _G.FX\nlocal CTitleUIPreviewCompClass = FX.Class(\"CTitleUIPreviewCompClass\", \"CTitleUIBaseCompClass\")\n\n-- 初始化本次运行的模拟数据。\n-- @param owner table 编辑器提供的组件宿主，传递给父类\nfunction CTitleUIPreviewCompClass:Ctor(owner)\n    CTitleUIPreviewCompClass.Super.Ctor(self, owner)\n    self.Config = {}\n    self.State = {}\nend\n\n-- 提供展示配置，业务标识与文案分开保存。\n-- @return table 界面配置\nfunction CTitleUIPreviewCompClass:GetUIConfig()\n    return self.Config\nend\n\n-- 提供模拟状态，不能作为真实发奖依据。\n-- @return table 当前显示状态\nfunction CTitleUIPreviewCompClass:GetUIState()\n    return self.State\nend\n\n-- 数据就绪后触发首帧展示。\nfunction CTitleUIPreviewCompClass:BindUIData()\n    self:RefreshUI()\nend\n\n-- 处理展示层动作；只更新模拟数据，再调用 RefreshUI。\n-- @param action string 动作名称\n-- @param payload table 动作必要参数，例如稳定奖励 ID\nfunction CTitleUIPreviewCompClass:OnUIAction(action, payload)\nend\n\nreturn CTitleUIPreviewCompClass",
    "source": "local FX = _G.FX\nlocal FXLoader = FX.Loader\nlocal CTitleUIBaseCompClass = FX.Class(\"CTitleUIBaseCompClass\", \"FCUICompClass\")\n\n-- 先用 FXLoader:PlayerGui(\"实际ScreenGui名\") 获取界面，再用 Here(root, \"Panel.Button\") 查子节点。\nfunction CTitleUIBaseCompClass:OnReady()\nend\n\n-- 根据接入类数据刷新展示，不在这里创建视觉效果。\n-- @param state table 接入类提供的显示状态\nfunction CTitleUIBaseCompClass:Render(state)\nend\n\nreturn CTitleUIBaseCompClass"
  },
  "version": 3
}
